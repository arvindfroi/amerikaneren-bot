node_modules/
dist/
*.log
*.log.*
# stderr fra bakgrunnsprosesser (tomme naar alt gikk bra)
*.err
.DS_Store
# midlertidige skrap-filer
/_*
# NEAT-treningsartefakter (mestergenomer m.m.)
trening*/
# E1: orakel-datasett (hundrevis av MB, regenereres av e1-orakel.ts)
e1-data/
# E1: trente vekter (regenereres av verktoy/e1-tren.py)
e1-modell/
# midlertidige eksperiment-artefakter (maalinger, ablasjoner, testkjoeringer)
trumf-med/
trumf-uten/
trumftest/
laerling-test/
obduksjon/
obduksjon-eksakt/
e1-maalinger.jsonl
tidligspill*.txt
beskjaering*/
bidrag/
plan-med/
plan-uten/
fasit-med/
fasit-uten/
moe/
avmettet*.json
avm-*.json
trening-d5/
e1-data2/
e1-data3/
# SD: kortdatasettet fra sd-orakel.ts (samme format som e1-data, egen mappe
# fordi treneren blander alt som ligger i samme mappe)
sd-data/
# SD runde 2 (DAgger): stillingene fra sd-r1s EGEN spilling, samme format og
# samme grunn til å ligge i egen mappe. 2,8 GB.
sd-data2/
# SD-holdouten: linjer sd-orakel-skårene skrev ETTER at treneren leste ferdig,
# klippet ut av sd-data. Regenereres av kommandoen i docs/moe2.md.
sd-frys/
# SD-holdouten for runde 2: delt paa GIV, ikke paa stilling. Skrives av
# `verktoy/sd-tren.py --dumpholdout sd-frys2` og er nøyaktig de partiene
# treneren holdt utenfor.
sd-frys2/
# arena: byggeartefakter og kopiert appkode (hentes med arena/hent-appkode.sh)
arena/adapter/.build/
arena/adapter/Sources/adapter/appkode/
e1-frys/
# MesterAI-beslutninger fra examples/mester-orakel.ts (atferdskloning).
# Hundrevis av MB, regenereres av skriptet - og maa ALDRI blandes med sd-data:
# fasiten her er ett valgt kort (`k`), ikke en verdivektor (`v`).
mester-data/
# budgrense: én linje per (kandidat, giv, sete, runde) – titalls MB, og all
# statistikken er destillert til analyse/budgrense.{txt,json}. Regenereres av
# kommandoen i docs/moe2.md. `budgrense-givere-*.jsonl` (én linje per kamp)
# er små og ligger i git.
analyse/budgrense-runder-*.jsonl
# håndvurdering: (trekk → SD)-datasettet fra examples/handvurdering.ts --data.
# Hundrevis av MB, regenereres på minutter fordi fasiten er gratis.
hand-data/
# håndvurderingens holdout, delt paa GIV (verktoy/hand-tren.py --dumpholdout)
hand-frys/
# rundelogger fra spillmaalingen av haandvurderingen – samme grunn som
# budgrense-runder: titalls MB, destillert til analyse/handvurdering.{txt,json}
analyse/handvurdering-runder-*.jsonl
sd-buffer/

# Korpus- og datamapper (store, regenererbare)
#
# MOENSTER, IKKE LISTE - og det er en RETTELSE 6. august.
#
# Dette var en haandholdt liste, og den maatte utvides for hver nye
# korpusmappe. Det ble glemt ELLEVE ganger: sd-data3, sd-v4, sd-v5, sd-v7,
# sd-v8, sd-v8b, sd-v9, sd-nevro, sd-vakt, tro-data og vrak-data laa alle
# usporet OG uignorert.
#
# Konsekvensen var ikke kosmetisk. `git add -A` forsoekte aa lese ~15 GB og
# feilet med «fatal: mmap failed: Invalid argument» - altsaa kunne ingen
# committe med -A i det hele tatt, og en uoppmerksom `git add .` ville
# forsoekt aa legge 15 GB korpus i historikken.
#
# Verifisert foer bytte: `git ls-files` matcher INGEN sporet fil mot noen av
# moenstrene under. analyse/ (544 sporede filer) treffes ikke.
sd-*/
*-data/
*-data-gammel/
bud-adams2/
tro-data/
vrak-data/

# MLB fase 0.5 (§123): epokedriverens mellomlagre.
# Kamploggene er ~23 MB per epoke og erfaringsfilene ~1,2 GB — de skrives om
# igjen hver epoke og kan gjenskapes fra froeet. Rapportene under analyse/
# er det varige sporet.
mlb-epoke-data/

# Portens raa skardfiler: 20 per arm per epoke, destillert til
# analyse/mlb-epoke/e*-port-rapport.txt og -dom.jsonl.
analyse/mlb-epoke/*-port-par-*.jsonl
analyse/mlb-epoke/*-port-liga-*.jsonl
